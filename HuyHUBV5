local Motion = {}
do
    local T = {
        pop  = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        out  = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        in_  = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
        snap = TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    }
    function Motion.to(inst, props, preset)
        local tw = Tween:Create(inst, T[preset or "out"], props); tw:Play(); return tw
    end
    function Motion.spring(inst, prop, target, opts)
        opts = opts or {}
        local k, damp = opts.stiffness or 180, opts.damping or 18
        local v, x = 0, inst[prop]
        local conn
        conn = RS.RenderStepped:Connect(function(_, dt)
            dt = math.min(dt, 1/30)
            local a = -k * (x - target) - damp * v
            v = v + a * dt; x = x + v * dt
            inst[prop] = x
            if math.abs(v) < 0.01 and math.abs(x - target) < 0.01 then
                inst[prop] = target; conn:Disconnect()
            end
        end)
    end
end

