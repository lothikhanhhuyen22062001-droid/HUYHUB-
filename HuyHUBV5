-- [9] STORE · Redux-like reactive
--=============================================================
local Store = {}
Store.__index = Store
function Store.new(init, reducer)
    return setmetatable({
        state = K.clone(init), reducer = reducer, listeners = {}, history = {}, historyLimit = 50,
    }, Store)
end
function Store:dispatch(action)
    local prev = self.state
    local next = self.reducer(self.state, action) or self.state
    if next ~= prev then
        table.insert(self.history, { action = action, prev = prev })
        if #self.history > self.historyLimit then table.remove(self.history, 1) end
        self.state = next
        for _, l in ipairs(self.listeners) do task.spawn(l, next, prev, action) end
    end
    return next
end
function Store:subscribe(fn)
    table.insert(self.listeners, fn)
    return function()
        for i, l in ipairs(self.listeners) do
            if l == fn then table.remove(self.listeners, i); break end
        end
    end
end

