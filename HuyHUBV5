-- [11] AUTH · verify (server + local fallback)
--=============================================================
local Auth = {}
Auth.__index = Auth

local EXPECTED_HASH = Crypto.fnv1a(CONFIG.CORRECT_KEY .. CONFIG.SALT)
local function verifyLocal(key)
    return Crypto.ctEq(Crypto.fnv1a((key or "") .. CONFIG.SALT), EXPECTED_HASH)
end

function Auth.new()
    local net = #CONFIG.AUTH_ENDPOINT > 0 and Net.new({ baseURL = CONFIG.AUTH_ENDPOINT }) or nil
    return setmetatable({
        rl = RateLimit.new(3, 0.5),
        attempts = Persist.get("attempts", 0),
        lockUntil = Persist.get("lockUntil", 0),
        net = net,
    }, Auth)
end

function Auth:isLocked() return os.time() < self.lockUntil end
function Auth:_duration()
    local a = self.attempts
    return a >= 10 and 900 or a >= 6 and 300 or a >= 4 and 120 or a >= 3 and 60 or 30
end
function Auth:_fail()
    self.attempts = self.attempts + 1
    Persist.set("attempts", self.attempts)
    if self.attempts >= 3 then
        self.lockUntil = os.time() + self:_duration()
        Persist.set("lockUntil", self.lockUntil)
    end
end
function Auth:_reset()
    self.attempts = 0; self.lockUntil = 0
    Persist.set("attempts", 0); Persist.set("lockUntil", 0)
end

function Auth:verify(key, cb)
    if self:isLocked() then
        return cb(false, "locked", { seconds = self.lockUntil - os.time() })
    end
    if not self.rl:try() then
        return cb(false, "rate_limited", nil)
    end

    if self.net then
        task.spawn(function()
            local ok, res = K.retry(function()
                return self.net:post(CONFIG.AUTH_PATH, {
                    key = key, hwid = HWID.get(), userId = LP.UserId, v = "5.0",
                })
            end, 2, 0.5)()
            if ok and res and res.valid then
                self:_reset()
                Persist.set("token", res.token or "")
                Persist.set("tier", res.tier or "free")
                Persist.set("expire", res.expire or 0)
                cb(true, res.token, res)
            elseif ok and res then
                self:_fail(); cb(false, res.reason or "invalid", res)
            else
                if verifyLocal(key) then self:_reset(); cb(true, "offline", { offline = true })
                else self:_fail(); cb(false, "network_fail", nil) end
            end
        end)
    else
        task.spawn(function()
            task.wait(0.35)
            if verifyLocal(key) then self:_reset(); cb(true, "offline", { offline = true })
            else self:_fail(); cb(false, "invalid", nil) end
        end)
    end
end

