-- [4] PERSIST · encrypted local KV cache
--=============================================================
local Persist = {}
do
    local FILE = "huyhub_v5.cache"
    local cache = nil

    local function load()
        if cache then return cache end
        cache = {}
        local ok, raw = pcall(readfile, FILE)
        if ok and raw and #raw > 0 then
            local dok, dec = pcall(Crypto.decrypt, raw)
            if dok then
                local pok, tbl = pcall(function() return loadstring("return "..dec)() end)
                if pok and type(tbl) == "table" then cache = tbl end
            end
        end
        return cache
    end

    local function flush()
        if not cache then return end
        local p = {}
        for k, v in pairs(cache) do
            if type(v) == "string" then p[#p+1] = string.format("[%q]=%q", k, v)
            elseif type(v) == "number" or type(v) == "boolean" then p[#p+1] = string.format("[%q]=%s", k, tostring(v)) end
        end
        pcall(writefile, FILE, Crypto.encrypt("{"..table.concat(p, ",").."}"))
    end

    function Persist.get(k, d) local c = load(); return c[k] ~= nil and c[k] or d end
    function Persist.set(k, v) local c = load(); c[k] = v; flush() end
    function Persist.clear() cache = {}; pcall(delfile, FILE) end
end

