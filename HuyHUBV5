-- [7] NET · HTTP client with retry + circuit breaker
--=============================================================
local Net = {}
Net.__index = Net
function Net.new(cfg)
    return setmetatable({
        baseURL = cfg.baseURL, failures = 0, breakerUntil = 0,
        threshold = cfg.threshold or 5, cooldown = cfg.cooldown or 15,
    }, Net)
end
function Net:_req(method, path, body)
    if os.clock() < self.breakerUntil then return false, "circuit_open" end
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if not req then return false, "no_http_lib" end
    local ok, res = pcall(req, {
        Url = self.baseURL..path, Method = method,
        Headers = { ["Content-Type"]="application/json", ["X-Hub"]="HuyHub-v5" },
        Body = body and Http:JSONEncode(body) or nil,
    })
    if not ok or not res or res.StatusCode >= 500 then
        self.failures = self.failures + 1
        if self.failures >= self.threshold then
            self.breakerUntil = os.clock() + self.cooldown
            self.failures = 0
        end
        return false, res and res.StatusCode or "network_error"
    end
    self.failures = 0
    local dok, dec = pcall(Http.JSONDecode, res.Body)
    return true, dok and dec or res.Body
end
function Net:post(p, b) return self:_req("POST", p, b) end
function Net:get(p) return self:_req("GET", p) end

