-- [6] RATE LIMIT · token bucket
--=============================================================
local RateLimit = {}
RateLimit.__index = RateLimit
function RateLimit.new(cap, rate)
    return setmetatable({ cap = cap, tokens = cap, rate = rate, last = os.clock() }, RateLimit)
end
function RateLimit:try()
    local now = os.clock()
    self.tokens = math.min(self.cap, self.tokens + (now - self.last) * self.rate)
    self.last = now
    if self.tokens >= 1 then self.tokens = self.tokens - 1; return true end
    return false
end

