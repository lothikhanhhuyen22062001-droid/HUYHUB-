local K = {}
function K.clone(t) local r={} for k,v in pairs(t) do r[k]=v end return r end
function K.merge(...) local o={} for _,t in ipairs({...}) do for k,v in pairs(t) do o[k]=v end end return o end
function K.retry(fn, attempts, base)
    attempts, base = attempts or 3, base or 0.4
    return function(...)
        local a = {...}
        for i = 1, attempts do
            local ok, r = pcall(fn, table.unpack(a))
            if ok then return true, r end
            if i < attempts then task.wait(base * (2^(i-1))) end
        end
        return false, "max_retries"
    end
end

--=============================================================
-- [3] CRYPTO · XOR+Base64 + FNV-1a
--=============================================================
local Crypto = {}
do
    local KEY = {0x48,0x75,0x79,0x48,0x75,0x62,0x35,0x30}
    local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

    local function xorBytes(str)
        local out = {}
        for i = 1, #str do
            out[i] = string.char(bit32.bxor(string.byte(str, i), KEY[((i-1) % #KEY) + 1]))
        end
        return table.concat(out)
    end

    local function b64Encode(data)
        return ((data:gsub('.', function(x)
            local r, b = '', x:byte()
            for i = 8,1,-1 do r = r .. (b % 2^i - b % 2^(i-1) > 0 and '1' or '0') end
            return r
        end)..'0000'):gsub('%d%d%d?%d?%d?%d?', function(x)
            if #x < 6 then return '' end
            local c = 0
            for i = 1, 6 do c = c + (x:sub(i,i) == '1' and 2^(6-i) or 0) end
            return B64:sub(c+1, c+1)
        end)..({ '', '==', '=' })[#data % 3 + 1])
    end

    local function b64Decode(data)
        data = data:gsub('[^'..B64..'=]', '')
        return (data:gsub('.', function(x)
            if x == '=' then return '' end
            local r, f = '', (B64:find(x) - 1)
            for i = 6,1,-1 do r = r .. (f % 2^i - f % 2^(i-1) > 0 and '1' or '0') end
            return r
        end):gsub('%d%d%d?%d?%d?%d?%d?%d?', function(x)
            if #x ~= 8 then return '' end
            local c = 0
            for i = 1, 8 do c = c + (x:sub(i,i) == '1' and 2^(8-i) or 0) end
            return string.char(c)
        end))
    end

    function Crypto.encrypt(s) return b64Encode(xorBytes(s)) end
    function Crypto.decrypt(s) return xorBytes(b64Decode(s)) end

    function Crypto.fnv1a(str)
        local h = 2166136261
        for i = 1, #str do
            h = bit32.bxor(h, string.byte(str, i))
            h = (h * 16777619) % 4294967296
        end
        return h
    end

    function Crypto.ctEq(a, b)
        if type(a) ~= "number" or type(b) ~= "number" then return false end
        local d = 0
        for i = 0, 31 do
            d = bit32.bor(d, bit32.band(bit32.rshift(a, i), 1) ~= bit32.band(bit32.rshift(b, i), 1) and 1 or 0)
        end
        return d == 0
    end
end

