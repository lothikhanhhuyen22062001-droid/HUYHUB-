local INITIAL_STATE = {
    tab = 1, key = "", status = "idle", lockedUntil = 0,
    toast = {}, lang = I18N.getLang(), loading = false, loadingMsg = "",
}

local function reducer(state, action)
    local t = action.type
    if t == "TAB_SET"    then return K.merge(state, { tab = action.payload })
    elseif t == "KEY_SET" then return K.merge(state, { key = action.payload })
    elseif t == "STATUS_SET" then return K.merge(state, { status = action.payload })
    elseif t == "LOCK_SET" then return K.merge(state, { lockedUntil = action.payload })
    elseif t == "TOAST_PUSH" then
        local n = K.clone(state.toast); n[#n+1] = action.payload
        return K.merge(state, { toast = n })
    elseif t == "TOAST_DROP" then
        local n = {}
        for _, x in ipairs(state.toast) do if x.id ~= action.payload then n[#n+1] = x end end
        return K.merge(state, { toast = n })
    elseif t == "LOADING_SET" then return K.merge(state, { loading = action.payload.on, loadingMsg = action.payload.msg or "" })
    elseif t == "LANG_SET" then I18N.setLang(action.payload); return K.merge(state, { lang = action.payload })
    end
    return state
end

